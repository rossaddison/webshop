APP_ENV=local

# 'dev', 'prod', or 'test'. Selects which
# config/environments/{dev,prod,test}/params.php gets merged in — 'prod'
# is the only one that turns on FastRoute's route-dispatch cache.
YII_ENV=dev
YII_DEBUG=true

BASE_URL=

# Signs/encrypts cookies — required.
COOKIE_SECRET_KEY=

SESSION_COOKIE_SECURE=false

# The invoice app this storefront proxies product/order calls to. See
# docs/DESIGN.md and App\Catalog\ProductCatalogClient /
# App\Checkout\OrderApiClient.
INVOICE_API_BASE_URL=https://yii3i.online
INVOICE_API_KEY=
