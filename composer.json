{
    "name": "rossaddison/webshop",
    "type": "project",
    "description": "Headless storefront for rossaddison/invoice — no local database; product catalog and checkout are proxied to invoice's API, cart lives in session. See docs/DESIGN.md.",
    "keywords": [
        "yii",
        "webshop",
        "storefront",
        "headless"
    ],
    "homepage": "https://github.com/rossaddison/webshop",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "8.3 - 8.5",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-filter": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": ">=8.0.1",
        "guzzlehttp/psr7": ">=3",
        "nyholm/psr7": "^1.8.2",
        "psr/container": "^2.0.2",
        "psr/http-client": ">=1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "psr/log": "^3.0.2",
        "symfony/console": ">=8.1.1",
        "symfony/process": ">=8.1.0",
        "vlucas/phpdotenv": "^5.6.4",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/arrays": "^3.2.1",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/bootstrap5": "^1.2",
        "yiisoft/cache": "^3.2",
        "yiisoft/cache-apcu": "^1.1",
        "yiisoft/cache-file": "^3.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/cookies": "^1.2.4",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/data-response": "^2.2.0",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/factory": "^1.3.1",
        "yiisoft/files": "^2.1",
        "yiisoft/form": "^1.5.2",
        "yiisoft/form-model": "^1.1.1",
        "yiisoft/friendly-exception": "^1.2",
        "yiisoft/html": ">=4.2",
        "yiisoft/http": "^1.3",
        "yiisoft/i18n": "^1.2.2",
        "yiisoft/injector": "^1.2.1",
        "yiisoft/input-http": ">=1.0.1",
        "yiisoft/json": "^1.1",
        "yiisoft/log": ">=2.2.1",
        "yiisoft/log-target-file": ">=3.1",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/rate-limiter": "dev-master",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/security": "^1.2.0",
        "yiisoft/session": "^3.0.1",
        "yiisoft/strings": "^2.7",
        "yiisoft/translator": "^3.2.1",
        "yiisoft/translator-message-php": "^1.1.2",
        "yiisoft/validator": "^2.6.0",
        "yiisoft/var-dumper": "^1.7.1",
        "yiisoft/view": "^12.2.4",
        "yiisoft/widget": "^2.2.2",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-event": "^2.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-middleware": "^1.1.2",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.4.1"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.11.0",
        "mockery/mockery": "^1.6.12",
        "testo/bridge-mockery": "^0.1.1",
        "testo/facade": ">=0.1.1",
        "testo/testo": "^0.10.38",
        "vimeo/psalm": ">=6.16.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Testo\\": "Tests/Testo"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "./yii serve"
        ],
        "test:unit": "vendor/bin/testo --suite=Unit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "config-plugin-file": "configuration.php"
    },
    "config": {
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "yiisoft/config": true,
            "php-http/discovery": false
        }
    }
}
